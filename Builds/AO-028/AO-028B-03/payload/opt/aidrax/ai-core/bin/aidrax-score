#!/usr/bin/env python3
import json
import sys

if len(sys.argv) != 5:
    print("usage: aidrax-score <success 0|1> <validation 0|1> <confidence 0-100> <risk 0-100>")
    raise SystemExit(2)

success = int(sys.argv[1])
validation = int(sys.argv[2])
confidence = max(0, min(100, int(sys.argv[3])))
risk = max(0, min(100, int(sys.argv[4])))

score = (
    success * 35 +
    validation * 35 +
    confidence * 0.30 -
    risk * 0.20
)

score = max(0, min(100, round(score, 2)))

print(json.dumps({
    "quality_score": score,
    "confidence": confidence,
    "risk": risk
}, indent=2))
