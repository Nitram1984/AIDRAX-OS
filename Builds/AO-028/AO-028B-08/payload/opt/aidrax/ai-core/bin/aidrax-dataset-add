#!/usr/bin/env python3
import json
import sys
from datetime import datetime, timezone
from pathlib import Path

ROOT = Path("/var/lib/aidrax/ai-core/evolution/datasets")

if len(sys.argv) < 4:
    print("usage: aidrax-dataset-add <training|evaluation> <input> <expected-output>")
    raise SystemExit(2)

kind = sys.argv[1]

if kind not in ("training", "evaluation"):
    raise SystemExit("invalid dataset kind")

target = ROOT / kind / "dataset.jsonl"
target.parent.mkdir(parents=True, exist_ok=True)

entry = {
    "timestamp": datetime.now(timezone.utc).isoformat(),
    "input": sys.argv[2],
    "expected_output": " ".join(sys.argv[3:])
}

with target.open("a", encoding="utf-8") as f:
    f.write(json.dumps(entry, ensure_ascii=False) + "\n")

print("stored:", target)
