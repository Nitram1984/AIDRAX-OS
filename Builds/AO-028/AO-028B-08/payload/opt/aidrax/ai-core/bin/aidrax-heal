#!/usr/bin/env python3
import json
import sys
from datetime import datetime, timezone

if len(sys.argv) < 3:
    print("usage: aidrax-heal <component> <error>")
    raise SystemExit(2)

print(json.dumps({
    "timestamp": datetime.now(timezone.utc).isoformat(),
    "component": sys.argv[1],
    "error": " ".join(sys.argv[2:]),
    "action": "repair-proposal-required",
    "auto_repair": False,
    "owner_gate_required": True
}, indent=2))
